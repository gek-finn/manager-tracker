# Example only. No values or active secrets. This file is NOT loaded automatically.
# local or production; production requires every parameter below.
TRACKER_MODE=
# Cryptographically random persistent key, >=32 characters. Never commit it.
TRACKER_SECRET_KEY=
# Single owner login; no registration.
TRACKER_OWNER_LOGIN=
# Werkzeug scrypt hash; never a plain password.
TRACKER_OWNER_PASSWORD_HASH=
# Absolute SQLite file path in production; existing writable parent directory.
TRACKER_DATABASE=
# Exact hostnames separated by commas, without schemes, ports, leading dots or wildcards.
TRACKER_ALLOWED_HOSTS=

# Optional single private JSON file in production, generated on the server.
TRACKER_SERVER_CONFIG=
# Explicit trust: 0 or 1; only with exactly one local Nginx proxy.
TRACKER_TRUST_LOCAL_PROXY=
