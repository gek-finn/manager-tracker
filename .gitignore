# Public source allowlist. Unknown root files are private until reviewed.
/*
!/*.py
!/.gitignore
!/.env.example
!/README.md
!/requirements.txt
!/requirements-production.txt
!/запуск.bat
!/templates/
/templates/*
!/templates/*.html
!/static/
/static/*
!/static/app.js
!/static/style.css
!/tests/
/tests/*
!/tests/test_*.py
!/deploy/
/deploy/*
!/deploy/INSTALL.md
!/deploy/gunicorn.conf.py
!/deploy/manager-tracker.service
!/deploy/manager-tracker-backup.service
!/deploy/manager-tracker-backup.timer
!/deploy/nginx-http.conf
!/deploy/nginx-https.conf
!/deploy/certbot-deploy-hook.sh
!/deploy/server-config.example.json
!/docs/
/docs/*
!/docs/USER_GUIDE.md
!/docs/PUBLICATION.md
!/docs/PUBLIC_FILES.txt

# Defense in depth: data, secrets and generated files at every depth.
**/__pycache__/
**/.venv*/
**/venv/
**/.dependencies/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.runtime/
**/.qa*/
**/instance/
**/backups/
**/exports/
**/artifacts/
**/tmp*/
**/local-owner.json*
**/server-owner.json*
**/.env
**/.env.*
!/.env.example
*.py[cod]
*.sqlite*
*.db
*.db-*
*-wal
*-shm
*-journal
*.csv
*.log
*.jsonl
*.zip
*.7z
*.rar
*.tar
*.gz
*.bak
*.old
*.tmp
*.pem
*.key
*.p12
*.pfx
*.ppk
**/id_rsa*
**/id_ed25519*
.DS_Store
Thumbs.db
