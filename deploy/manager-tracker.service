[Unit]
Description=Manager Tracker owner application
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=manager-tracker
Group=manager-tracker
WorkingDirectory=/opt/manager-tracker
Environment=TRACKER_SERVER_CONFIG=/etc/manager-tracker/server-owner.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/manager-tracker/.venv/bin/gunicorn --config /opt/manager-tracker/deploy/gunicorn.conf.py wsgi:application
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/manager-tracker
MemoryAccounting=true
MemoryMax=256M
TasksMax=32

[Install]
WantedBy=multi-user.target
